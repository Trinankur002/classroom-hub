DATABASE_URL=
JWT_SECRET=your-secret-key

# Required for file upload features.
# The current backend file service uses Google Cloud Storage.
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GCP_KEY_FILE=./gcp-key.json

# Required for live classes.
# If you use the bundled local LiveKit config in server/livekit/livekit.yaml,
# the default dev values are:
# LIVEKIT_API_KEY=devkey
# LIVEKIT_SECRET=secret
# LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_SECRET=
LIVEKIT_URL=

# Optional Cloudflare R2 credentials.
# Present in the codebase, but the current file service path is GCS-based.
# CF_ACCOUNT_ID=
# CF_ACCESS_KEY_ID=
# CF_SECRET_ACCESS_KEY=
# CF_BUCKET_NAME=

# Optional Redis credentials for notification/queue work.
# The notification module exists in the repo but is not currently enabled
# in AppModule.
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_TLS=true

# Optional frontend URL.
# The current backend enables CORS with origin: true, so this is not required
# by the current bootstrap.
# FRONTEND_URL=http://localhost:5173
